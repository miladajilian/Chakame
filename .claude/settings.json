{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test-ui)",
      "Bash(make test-all)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make clean)",
      "Bash(make help)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcrun xcresulttool:*)",
      "Bash(./scripts/sim-destination.sh)",
      "Bash(swiftlint:*)",
      "Bash(swiftformat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/swiftformat-edited-file.sh"
          }
        ]
      }
    ]
  }
}
