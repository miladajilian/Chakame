    "Refresh Poems from Ganjoor" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌روزرسانی اشعار از گنجور"
          }
        }
      }
    },
    "RefreshConfirmationMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشعار ذخیره‌شده پاک می‌شوند و هنگام باز کردن، تازه‌ترین نسخه از گنجور دریافت می‌شود. برای این کار به اینترنت نیاز دارید. اشعار مورد علاقهٔ شما باقی می‌مانند."
          }
        }
      }
    },
    "RefreshExplanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چکامه شاعران و اشعاری را که باز می‌کنید روی گوشی ذخیره می‌کند تا دفعهٔ بعد سریع‌تر و حتی بدون اینترنت باز شوند. اگر از آن زمان در گنجور شاعر یا شعر تازه‌ای منتشر شده یا متنی اصلاح شده، با این گزینه نسخهٔ ذخیره‌شده پاک می‌شود و همه‌چیز دوباره و تازه از گنجور دریافت می‌شود. اشعار مورد علاقهٔ شما حفظ می‌شوند."
          }
        }
      }
    },
    "Saved data was cleared. Poems now load fresh from Ganjoor." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داده‌های ذخیره‌شده پاک شد. اشعار اکنون تازه از گنجور دریافت می‌شوند."
          }
        }
      }
    },
